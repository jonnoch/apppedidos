# === Supabase ===
# Project URL (Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave pública / anon (Settings -> API -> Project API keys -> anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Clave de servicio (Settings -> API -> service_role). SOLO en el servidor, NUNCA en el navegador.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# === Configuración de la sede piloto ===
# ID de la ubicación piloto (debe coincidir con el seed en Supabase)
NEXT_PUBLIC_LOCATION_ID=facatativa-piloto
